// Windows resources: application icon and version information
#include <winver.h>

IDI_ICON1 ICON "@NIXSCP_ICO@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "CodeWiz"
      VALUE "FileDescription", "@NIXSCP_DESCRIPTION@"
      VALUE "FileVersion", "@PROJECT_VERSION@"
      VALUE "InternalName", "@NIXSCP_TARGET@"
      VALUE "LegalCopyright", "Copyright (c) 2026 Dragan Plavsic, CodeWiz. Based on WinSCP, (c) 2000-2026 Martin Prikryl. GPL-3.0."
      VALUE "OriginalFilename", "@NIXSCP_TARGET@.exe"
      VALUE "ProductName", "NixSCP"
      VALUE "ProductVersion", "@PROJECT_VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
