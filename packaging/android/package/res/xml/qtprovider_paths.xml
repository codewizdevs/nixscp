<?xml version="1.0" encoding="utf-8"?>
<!-- Files NixSCP may hand to other apps (Open): its private files, the
     downloads in its external folder and opened files in its cache -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <files-path name="files_path" path="/"/>
    <external-files-path name="downloads" path="."/>
    <cache-path name="opened" path="open/"/>
</paths>
