  <name>NixSCP</name>
  <summary>SFTP, SCP and FTP client with the WinSCP interface</summary>
  <description>
    <p>
      NixSCP is a native Linux port of WinSCP. It provides the familiar
      WinSCP Commander interface for copying files between a local and a
      remote computer over SFTP, SCP, FTP and FTPS.
    </p>
    <p>Features:</p>
    <ul>
      <li>Two-panel Commander interface with a transfer queue</li>
      <li>Site Manager compatible with the WinSCP.ini configuration format</li>
      <li>Directory synchronization and file search</li>
      <li>Integrated text editor</li>
      <li>Console scripting client (nixscp-cli) compatible with WinSCP scripts</li>
    </ul>
  </description>
  <launchable type="desktop-id">nixscp.desktop</launchable>
  <provides>
    <binary>nixscp</binary>
    <binary>nixscp-cli</binary>
  </provides>
